{
  "name": "@lastbell/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "hardhat build",
    "typecheck": "hardhat build --quiet && tsc -p tsconfig.json",
    "test": "hardhat test",
    "test:stress": "cross-env INVARIANT_SEEDS=25 INVARIANT_STEPS=400 hardhat test test/invariants.test.ts",
    "export-abi": "hardhat build --quiet && hardhat run scripts/export-abi.ts",
    "mainnet:preflight": "tsx scripts/mainnet/preflight.ts",
    "mainnet:deploy": "hardhat build --quiet && tsx scripts/mainnet/deploy.ts",
    "mainnet:deploy:broadcast": "hardhat build --quiet && cross-env BROADCAST=1 tsx scripts/mainnet/deploy.ts",
    "mainnet:bond": "tsx scripts/mainnet/bond.ts",
    "mainnet:bond:broadcast": "cross-env BROADCAST=1 tsx scripts/mainnet/bond.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@openzeppelin/contracts": "5.6.1",
    "@types/node": "^22.19.0",
    "cross-env": "^7.0.3",
    "hardhat": "3.21.2",
    "typescript": "~5.9.3",
    "viem": "2.57.14",
    "tsx": "4.23.15"
  }
}
