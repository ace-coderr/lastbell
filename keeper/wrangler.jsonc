{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lastbell-keeper",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "RPC_URL": "https://rpc.mainnet.chain.robinhood.com",
    // Lastbell v2 on Robinhood Chain mainnet (docs/TRANSACTIONS.md).
    "LASTBELL_ADDRESS": "0x03f4Bf9214474f38D6DD6d60591419a923B4890e"
  },
  // Run log for /status. Wrangler provisions the namespace on first deploy.
  "kv_namespaces": [{ "binding": "STATE" }],
  "observability": { "enabled": true }
  // Secrets (set with `wrangler secret put`, never committed): KEEPER_PRIVATE_KEY
}
